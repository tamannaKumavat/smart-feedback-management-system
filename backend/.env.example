# Database
DATABASE_URL=postgresql+psycopg://user:password@host:5432/database?sslmode=require

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60

# Watsonx (existing)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
WATSONX_EMBEDDING_MODEL_ID=ibm/granite-embedding-278m-multilingual
MOCK_MODE=true

# RAG routing
RAG_RELEVANCE_THRESHOLD=0.75
RAG_KEYWORD_FALLBACK_SCORE=0.35

# Jira Cloud
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
JIRA_DEFAULT_ISSUE_TYPE=Task
JIRA_DEFAULT_ASSIGNEE_ACCOUNT_ID=
JIRA_WEBHOOK_SECRET=
JIRA_FIELD_SOURCE_CASE_ID=customfield_10074
JIRA_FIELD_FEEDBACK_ISSUE_TYPE_ID=customfield_10072
JIRA_FIELD_TEAM_ID=customfield_10001
JIRA_FIELD_RECOMMENDED_ACTION_ID=customfield_10073
JIRA_FIELD_SEVERITY_ID=customfield_10141
JIRA_FIELD_URGENCY_ID=customfield_10142
JIRA_TEAM_ID_SUPPORT=f8f908b0-2df0-45c1-bd92-ed5594eddb3f
JIRA_TEAM_ID_SOFTWARE_DEVELOPMENT=3c9816e9-8c41-4d32-a6db-2f18aaab911d
